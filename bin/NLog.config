<?xml version="1.0"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off" internalLogFile="c:\temp\nlog-internal.log">

	<!-- adds ${request-ms} and ${func-note} (they live in AutoBot.dll) -->
	<extensions>
		<add assembly="AutoBot" />
	</extensions>

	<targets async="true">
		<target name="txtfile" xsi:type="File"
			fileName="d:/logs/AutoBot/Debug/Debug.${date:format=yyyy-MM-dd}.txt"
			archiveFileName="d:/logs/AutoBot/archive/Debug/Debug.${date:format=yyyy-MM-dd}.txt"
			archiveEvery="Day"
			archiveNumbering="Date"
			archiveAboveSize="5000000"
			maxArchiveDays="5"
			concurrentWrites="true"
			layout="${longdate}|${level:uppercase=true}|${event-properties:item=func}|${message:withexception=true}|${request-ms}|${func-note}" />
	</targets>

	<rules>
		<logger name="*" minlevel="Info" writeTo="txtfile" />
	</rules>
</nlog>